rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cho phép người dùng đã đăng nhập đọc/ghi dữ liệu của chính mình
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // rule tạm thời cho dev: cho phép authentication user read/write mọi thứ
    // match /{document=**} {
    //   allow read, write: if request.auth != null;
    // }
  }
}
